{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run PHPUnit Tests",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/vendor/bin/phpunit",
            "args": [
                "--configuration=phpunit.xml.dist"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run PHPUnit SQLite Tests",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/vendor/bin/phpunit",
            "args": [
                "--configuration=phpunit.xml.dist",
                "--testsuite=Sqlite"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run PHPUnit MySQL Tests",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/vendor/bin/phpunit",
            "args": [
                "--configuration=phpunit.xml.dist",
                "--testsuite=Mysql"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Psalm Analysis",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/vendor/bin/psalm",
            "args": [
                "--show-info=false"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}