{
    "php.validate.enable": true,
    "php.validate.executablePath": "php",
    "php.suggest.basic": false,
    "php.format.enable": false,
    
    "intelephense.enabled": true,
    "intelephense.format.enable": true,
    "intelephense.completion.maxItems": 100,
    "intelephense.diagnostics.enable": true,
    "intelephense.diagnostics.run": "onType",
    "intelephense.phpdoc.returnVoid": false,
    "intelephense.phpdoc.useFullyQualifiedNames": false,
    
    "files.associations": {
        "*.php": "php",
        "composer.json": "json",
        "phpunit.xml.dist": "xml",
        "psalm.xml": "xml"
    },
    
    "files.exclude": {
        "**/vendor/**": true,
        "**/node_modules/**": true,
        "**/.phpunit.cache/**": true,
        "**/reports/**": true,
        "**/runtime/cache/**": true,
        "**/private/cache/**": true
    },
    
    "search.exclude": {
        "**/vendor/**": true,
        "**/node_modules/**": true,
        "**/.phpunit.cache/**": true,
        "**/reports/**": true
    },
    
    "phpunit.php": "php",
    "phpunit.phpunit": "./vendor/bin/phpunit",
    "phpunit.args": [
        "--configuration=phpunit.xml.dist"
    ],
    
    "psalm.enableUseIniDefaults": false,
    "psalm.configPaths": [
        "./psalm.xml"
    ],
    
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    
    "[php]": {
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    
    "[xml]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    
    "terminal.integrated.cwd": "${workspaceFolder}",
    
    "files.watcherExclude": {
        "**/vendor/**": true,
        "**/.phpunit.cache/**": true,
        "**/reports/**": true,
        "**/runtime/cache/**": true
    }
}